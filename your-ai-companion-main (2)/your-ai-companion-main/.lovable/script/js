}

/* إلا كانت مثلاً بطاقة سياش (CIH) أو نوع آخر - كيتغير اللونو أوتوماتيك */
.card[data-brand="cih"] .front {
  background: linear-gradient(135deg, #005A9C, #002244); /* أزرق ديال CIH مثلاً */
}

/* إلا كانت ماستر كارد أو نوع ثاني */
.card[data-brand="mc"] .front {
